{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StockReservedEvent",
  "type": "object",
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "enum": ["inventory.stock.reserved"] },
    "sourceService": { "type": "string", "enum": ["inventory-service"] },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string" },
    "payload": {
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "format": "uuid" },
        "orderNumber": { "type": "string" },
        "warehouseId": { "type": "string" },
        "productId": { "type": "string", "format": "uuid" },
        "reservedQuantity": { "type": "integer", "minimum": 1 },
        "remainingAvailable": { "type": "integer", "minimum": 0 }
      },
      "required": ["orderId", "warehouseId", "productId", "reservedQuantity"]
    }
  },
  "required": ["eventId", "eventType", "sourceService", "occurredAt", "correlationId", "payload"]
}
