# Environment variables for local development (git-ignored)
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_VIRTUAL_HOST=scm360

# Database credentials
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root

# Service DB Passwords
IDENTITY_DB_PASSWORD=identity_secret
CATALOG_DB_PASSWORD=catalog_secret
SUPPLIER_DB_PASSWORD=supplier_secret
PROCUREMENT_DB_PASSWORD=procurement_secret
INVENTORY_DB_PASSWORD=inventory_secret
WAREHOUSE_DB_PASSWORD=warehouse_secret
ORDER_DB_PASSWORD=order_secret
TRANSPORT_DB_PASSWORD=transport_secret
ANALYTICS_DB_PASSWORD=analytics_secret
NOTIFICATION_DB_PASSWORD=notification_secret

# MQ Passwords
IDENTITY_MQ_PASSWORD=identity_mq_secret
CATALOG_MQ_PASSWORD=catalog_mq_secret
SUPPLIER_MQ_PASSWORD=supplier_mq_secret
PROCUREMENT_MQ_PASSWORD=procurement_mq_secret
INVENTORY_MQ_PASSWORD=inventory_mq_secret
WAREHOUSE_MQ_PASSWORD=warehouse_mq_secret
ORDER_MQ_PASSWORD=order_mq_secret
TRANSPORT_MQ_PASSWORD=transport_mq_secret
ANALYTICS_MQ_PASSWORD=analytics_mq_secret
NOTIFICATION_MQ_PASSWORD=notification_mq_secret

# Gateway & Security
SCM_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
